# MAXXfam environment configuration
# Copy to .env during installation. Never commit .env.
APP_NAME="MAXXfam"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://payments.example.com

# 32-byte base64 key. Generate with: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_PORT=3306
DB_NAME=maxxfam
DB_USER=maxxfam
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_SECURE=true
SESSION_SAMESITE=Lax
SESSION_LIFETIME=3600
SESSION_NAME=MAXXFAMSESS

# smtp or mail
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="MAXXfam"
MAIL_TIMEOUT=12

# Public provider base URL (server-side only; credentials live encrypted in DB)
FAMGATEWAY_BASE_URL=https://famgateway.in

# Cron safety token (required for HTTP cron invocation)
CRON_TOKEN=

# Optional absolute path to a CA bundle for outbound Gmail IMAP TLS.
# Leave empty to use the system CA store.
IMAP_CA_BUNDLE=

# Set to 1 only if you understand that funds settle to the platform account
ALLOW_PLATFORM_DEFAULT_CREDENTIALS=0

# Trust X-Forwarded-* headers (only behind a trusted reverse proxy/load balancer)
TRUST_PROXY_HEADERS=false

LOG_LEVEL=warning
