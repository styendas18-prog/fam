{
  "name": "maxxfam/payments",
  "description": "MAXXfam - Smart Payments. Real Verification. Complete Control.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "check": "php tests/run.php",
    "cron:expire": "php cron/expire_orders.php",
    "cron:webhooks": "php cron/retry_webhooks.php",
    "cron:mail": "php cron/process_email.php"
  },
  "config": {
    "sort-packages": true
  }
}
